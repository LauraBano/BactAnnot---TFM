manifest {
    name            = 'LauraBano/bactannot'
    author          = 'Laura Bañó Benito'
    description     = 'Integration and functional analysis of bacterial gene annotations'
    mainScript      = 'main.nf'
    version         = '0.1.0-dev'
    nextflowVersion = '>=25.10.0'
}

includeConfig 'conf/base.config'

profiles {

    local {
        includeConfig 'conf/local.config'
    }
}